# ==========================================
# CASHFLOW IA - VARIABLES DE ENTORNO (.env)
# ==========================================

# NOTA: La API key del motor de IA NO se configura aquí ni en el frontend.
# Se configura como variable de entorno DEEPSEEK_API_KEY en el servidor
# (p.ej. Vercel: Settings -> Environment Variables). El frontend llama al
# proxy api/deepseek.js, que es quien posee la key.

# Opcional: solo si el proxy vive en otro dominio que el frontend
# VITE_DEEPSEEK_PROXY_URL=https://tu-dominio.com/api/deepseek

# 1. CREDENCIALES DE FIREBASE (Auth + Cloud Firestore)
# Consíguelas en Firebase Console -> Configuración del proyecto -> Tus apps (Web app)
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
